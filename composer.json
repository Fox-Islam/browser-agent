{
    "name": "phox/browser-agent",
    "description": "Probably the fastest goal-driven browser agent for PHP",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Fox Islam",
            "email": "fox@atarim.io"
        }
    ],
    "require": {
        "php": "^8.3",
        "guzzlehttp/guzzle": "^7.9",
        "psr/log": "^3.0"
    },
    "require-dev": {
        "laravel/pint": "^1.18",
        "pestphp/pest": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Phox\\BrowserAgent\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest",
        "lint": "pint --test"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
